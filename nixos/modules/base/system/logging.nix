      	kernel_rw_netlink_audit_sockets(syslogd_t)
      	kernel_use_fds(syslogd_t)

      	dev_read_kmsg(syslogd_t)
      	dev_read_urand(syslogd_t)
      	dev_write_kmsg(syslogd_t)

