        "/run/systemd/system(/.*)?" = lib.mkDefault "gen_context(system_u:object_r:systemd_unit_t,s0)";
        "/run/systemd/units(/.*)?" = lib.mkDefault "gen_context(system_u:object_r:systemd_unit_t,s0)";
        "/run/systemd/transient(/.*)?" =
