        "/etc/rc\\.d/rc" = lib.mkDefault "-- gen_context(system_u:object_r:initrc_exec_t,s0)";
        "/etc/rc\\.d/rc\\.[^/]+" = lib.mkDefault "-- gen_context(system_u:object_r:initrc_exec_t,s0)";

