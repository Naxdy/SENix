      userdom_manage_user_tmp_sockets(gconfd_t)
      userdom_tmp_filetrans_user_tmp(gconfd_t,{dir sock_file})
      userdom_user_runtime_filetrans_user_tmp(gconfd_t,dir)
      optional_policy(`
