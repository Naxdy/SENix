            "$2" = {
              name = "private type";
              description = "The type of the object to be created.";
            };
            "$3" = {
              name = "object";
              description = "The object class of the object being created.";
            };
            "$4" = {
              name = "name";
              description = "The name of the object being created.";
              optional = true;
