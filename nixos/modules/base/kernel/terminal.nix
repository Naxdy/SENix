    typeEnforcement = lib.mkBefore ''
      policy_module(terminal)

      ########################################
      #
      # Declarations
      #
      attribute ttynode;
      attribute ptynode;
      attribute server_ptynode;
      attribute serial_device;

      #
      # bsdpty_device_t is the type of /dev/[tp]ty[abcdepqrstuvwxyz][0-9a-f]
      type bsdpty_device_t;
      dev_node(bsdpty_device_t)

      #
      # console_device_t is the type of /dev/console.
      #
      type console_device_t;
      dev_node(console_device_t)

      #
      # devpts_t is the type of the devpts file system and
      # the type of the root directory of the file system.
      #
      type devpts_t;
      dev_associate(devpts_t)
      files_mountpoint(devpts_t)
      fs_associate_tmpfs(devpts_t)
      fs_xattr_type(devpts_t)
      fs_use_trans devpts gen_context(system_u:object_r:devpts_t,s0);

      #
      # devtty_t is the type of /dev/tty.
      #
      type devtty_t;
      dev_node(devtty_t)
      mls_trusted_object(devtty_t)

      optional_policy(`
      	container_mountpoint(devtty_t)
      ')

      #
      # ptmx_t is the type for /dev/ptmx.
      #
      type ptmx_t;
      dev_node(ptmx_t)
      mls_trusted_object(ptmx_t)
      allow ptmx_t devpts_t:filesystem associate;

      #
      # tty_device_t is the type of /dev/*tty*
      #
      type tty_device_t, serial_device;
      dev_node(tty_device_t)

      #
      # usbtty_device_t is the type of /dev/usr/tty*
      #
      type usbtty_device_t, serial_device;
      dev_node(usbtty_device_t)

      type virtio_device_t, serial_device;
      dev_node(virtio_device_t)
    '';
    fileContext = {
      rules = {
        # if /dev/ptmx is a symlink to /dev/pts/ptmx then we need to have /dev/pts/ptmx
        "/dev/.*tty[^/]*" = lib.mkDefault "-c gen_context(system_u:object_r:tty_device_t,s0)";
        "/dev/[pt]ty[a-ep-z][0-9a-f]" =
          lib.mkDefault "-c gen_context(system_u:object_r:bsdpty_device_t,s0)";
        "/dev/adb.*" = lib.mkDefault "-c gen_context(system_u:object_r:tty_device_t,s0)";
        "/dev/capi.*" = lib.mkDefault "-c gen_context(system_u:object_r:tty_device_t,s0)";
        "/dev/console" = lib.mkDefault "-c gen_context(system_u:object_r:console_device_t,s0)";
        "/dev/cu.*" = lib.mkDefault "-c gen_context(system_u:object_r:tty_device_t,s0)";
        "/dev/dcbri[0-9]+" = lib.mkDefault "-c gen_context(system_u:object_r:tty_device_t,s0)";
        "/dev/hpilo/[^/]*" = lib.mkDefault "-c gen_context(system_u:object_r:tty_device_t,s0)";
        "/dev/hvc.*" = lib.mkDefault "-c gen_context(system_u:object_r:tty_device_t,s0)";
        "/dev/hvsi.*" = lib.mkDefault "-c gen_context(system_u:object_r:tty_device_t,s0)";
        "/dev/i2c[^/]*" = lib.mkDefault "-c gen_context(system_u:object_r:tty_device_t,s0)";
        "/dev/ircomm[0-9]+" = lib.mkDefault "-c gen_context(system_u:object_r:tty_device_t,s0)";
        "/dev/ip2[^/]*" = lib.mkDefault "-c gen_context(system_u:object_r:tty_device_t,s0)";
        "/dev/isdn.*" = lib.mkDefault "-c gen_context(system_u:object_r:tty_device_t,s0)";
        "/dev/ptmx" = lib.mkDefault "-c gen_context(system_u:object_r:ptmx_t,s0)";
        "/dev/rfcomm[0-9]+" = lib.mkDefault "-c gen_context(system_u:object_r:tty_device_t,s0)";
        "/dev/slamr[0-9]+" = lib.mkDefault "-c gen_context(system_u:object_r:tty_device_t,s0)";
        "/dev/tty" = lib.mkDefault "-c gen_context(system_u:object_r:devtty_t,s0)";
        "/dev/ttySG.*" = lib.mkDefault "-c gen_context(system_u:object_r:tty_device_t,s0)";
        "/dev/vport[0-9]p[0-9]+" = lib.mkDefault "-c gen_context(system_u:object_r:virtio_device_t,s0)";
        "/dev/xvc[^/]*" = lib.mkDefault "-c gen_context(system_u:object_r:tty_device_t,s0)";

        "/dev/pty/.*" = lib.mkDefault "-c gen_context(system_u:object_r:bsdpty_device_t,s0)";

        "/dev/pts" = lib.mkDefault "-d gen_context(system_u:object_r:devpts_t,s0-mls_systemhigh)";

        # relabelled before sshd etc are ready to accept connections
        "/dev/pts/ptmx" = lib.mkDefault "-c gen_context(system_u:object_r:ptmx_t,s0)";

        "/dev/tts/[^/]*" = lib.mkDefault "-c gen_context(system_u:object_r:tty_device_t,s0)";

        "/dev/usb/tty.*" = lib.mkDefault "-c gen_context(system_u:object_r:usbtty_device_t,s0)";

        "/dev/vcc?/.*" = lib.mkDefault "-c gen_context(system_u:object_r:tty_device_t,s0)";

        "/dev/vcs[^/]*" = lib.mkDefault "-c gen_context(system_u:object_r:tty_device_t,s0)";

        "/dev/xvc[0-9]*" = lib.mkDefault "-c gen_context(system_u:object_r:tty_device_t,s0)";
      };
    };
