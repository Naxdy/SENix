      template(`ssh_role_template',`
      	gen_require(`
      		attribute ssh_server, ssh_agent_type;

      		type ssh_t, ssh_exec_t, ssh_home_t, ssh_agent_exec_t;
      		type ssh_agent_tmp_t;
