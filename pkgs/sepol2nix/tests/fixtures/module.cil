;;* lms 1 policy.cil
(class file (read write execute ioctl))
(class process (fork execmem))
(common file_common (read write))
(classcommon file file_common)
(classorder (unordered file) (process))
(classpermission file_rw)
(classpermissionset file_rw (file (read write)))
(classmap socket_map (send recv))
(classmapping socket_map send (tcp_socket (sendto)))

(handleunknown allow)
(mls true)

(sensitivity s0)
(sensitivityalias actual_low)
(sensitivityaliasactual actual_low s0)
(sensitivityorder (s0))
(category c0)
(categoryalias actual_cat)
(categoryaliasactual actual_cat c0)
(categoryorder (c0))
(sensitivitycategory s0 (c0))
(categoryset cats (c0))
(level low (s0 (cats)))
(levelrange low_high ((low) (low)))
(context fixture_context (fixture_u fixture_r fixture_t ((low) (low))))
(sid kernel)
(sidcontext kernel fixture_context)
(sidorder (kernel))

(user fixture_u)
(userattribute fixture_users)
(userattributeset fixture_users (fixture_u))
(userlevel fixture_u low)
(userrange fixture_u low_high)
(userbounds fixture_u fixture_u2)
(userprefix fixture_u fixture_)
(selinuxuser fixture_login fixture_u low_high)
(selinuxuserdefault fixture_u low_high)
(userrole fixture_u fixture_r)

(role fixture_r)
(roletype fixture_r fixture_t)
(roleattribute fixture_roles)
(roleattributeset fixture_roles (fixture_r))
(rolebounds fixture_r fixture_r2)
(roletransition fixture_r fixture_r fixture_t fixture_r)
(roleallow fixture_r fixture_roles)

(type fixture_t)
(typeattribute fixture_type)
(typeattributeset fixture_type (fixture_t fixture_alias_t))
(expandtypeattribute (fixture_type) true)
(typealias fixture_alias_t)
(typealiasactual fixture_alias_t fixture_t)
(typebounds fixture_t fixture_domain_t)
(typepermissive fixture_t)
(typeneveraudit fixture_t)
(typetransition fixture_t fixture_exec_t fixture_t "helper" fixture_t)
(typetransition fixture_t fixture_exec_t fixture_t helper_name fixture_t)
(typemember fixture_t fixture_exec_t fixture_t fixture_t)
(typechange fixture_t fixture_exec_t fixture_t fixture_t)
(rangetransition fixture_t fixture_exec_t fixture_t ((low) (low)))

(boolean fixture_bool true)
(tunable fixture_tunable false)
(tunableif (fixture_tunable) (true (allow fixture_t fixture_t (file (read)))) (false))
(booleanif (and fixture_bool (not fixture_bool)) (true) (false (dontaudit fixture_t fixture_t (file (read)))))

(allow fixture_t fixture_exec_t (file (read execute)))
(allow fixture_t fixture_exec_t file_rw)
(auditallow fixture_t fixture_exec_t (file (write)))
(dontaudit fixture_t fixture_exec_t (dir (search)))
(neverallow fixture_t fixture_exec_t (file (write)))
(allow fixture_t fixture_exec_t file_rw)
(deny fixture_t fixture_exec_t (file (write)))
(allowx fixture_t fixture_exec_t (ioctl file (0x5401)))
(neverallowx fixture_t fixture_exec_t (ioctl file (0x5401 0x5402)))

(permissionx fixture_ioctl (ioctl file (0x5401)))

(constrain (file (write)) (eq t1 t2))
(mlsconstrain (file (write)) (dom l1 l2))
(validatetrans file (eq t1 t2))
(mlsvalidatetrans file (incomp l1 h2))

(filecon "/etc/fixture.conf" file fixture_context)
(filecon "/etc/none" any ())
(portcon tcp 8080 fixture_context)
(portcon tcp (8080 8090) fixture_context)
(nodecon 192.0.2.1 255.255.255.0 fixture_context)
(nodecon 2001:db8:: 2001:db8::ffff fixture_context)
(genfscon proc /fixture fixture_context)
(genfscon proc /fixture file fixture_context)
(netifcon eth0 fixture_context fixture_context)
(pirqcon 5 fixture_context)
(iomemcon 0x1000 fixture_context)
(iomemcon (0x1000 0x2000) fixture_context)
(ioportcon 0x60 fixture_context)
(pcidevicecon 0x10 fixture_context)
(devicetreecon /soc/uart fixture_context)
(ibpkeycon 2001:db8:: 5 fixture_context)
(ibendportcon mlx5_0 1 fixture_context)
(fsuse xattr ext4 fixture_context)
(ipaddr fixture_addr 192.0.2.5)

(policycap extended_socket_class)
(defaultuser (file) source)
(defaultrole (file) target)
(defaulttype (file) source)
(defaultrange (file) target low)

(optional fixture_optional
	(allow fixture_t fixture_t (file (read))))
(macro fixture_macro ((type domain) (string name))
	(allow domain fixture_t (file (read))))
(call fixture_macro (fixture_t helper))

(block fixture_block
	(blockabstract fixture_block)
	(type fixture_block_t))
(blockinherit fixture_block)
(in after fixture_block (type fixture_in_t))
